  </ARTIFACT>

  <ARTIFACT ID="ART-EVOLUTION" FILE="docs/EVOLUTION.md" TYPE="HISTORY" STATE="IMPLEMENTED">
    <WHAT>Version history and recurring rejected patterns.</WHAT>
  </ARTIFACT>

  <ARTIFACT ID="ART-VISION" FILE="docs/VISION.md" TYPE="GUIDE" STATE="IMPLEMENTED">
    <WHAT>Where the protocol is going. Updated in v5 to reflect WHY layer.</WHAT>
  </ARTIFACT>

  <ARTIFACT ID="ART-ROADMAP" FILE="docs/ROADMAP.md" TYPE="PLANNING" STATE="IMPLEMENTED">
