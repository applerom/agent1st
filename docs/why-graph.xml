  <ARTIFACT ID="ART-WHY-APPROACH" FILE="docs/WHY-APPROACH.md" TYPE="GUIDE" STATE="IMPLEMENTED">
    <WHAT>The idea. Why intent must become a first-class artifact.</WHAT>
  </ARTIFACT>

  <ARTIFACT ID="ART-WHY-PRINCIPLES" FILE="docs/why-graph-principles.md" TYPE="GUIDE" STATE="IMPLEMENTED">
    <WHAT>Portable authoring guide for the Why Graph itself.</WHAT>
  </ARTIFACT>

  <ARTIFACT ID="ART-WHY-CONTRACTS" FILE="docs/why-contracts-v1.md" TYPE="GUIDE" STATE="IMPLEMENTED">
    <WHAT>Portable contract and anchor spec with Python + TypeScript examples.</WHAT>
  </ARTIFACT>

  <ARTIFACT ID="ART-WHY-GRAPH" FILE="docs/why-graph.xml" TYPE="GRAPH" STATE="IMPLEMENTED">
    <WHAT>This file. Teaching-size example, dogfooding Agent1st itself.</WHAT>
  </ARTIFACT>

  <ARTIFACT ID="ART-DESIGN" FILE="docs/DESIGN.md" TYPE="GUIDE" STATE="IMPLEMENTED">
