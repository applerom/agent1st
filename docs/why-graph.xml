    <REL TYPE="IMPLEMENTED_BY" TARGET="ARTIFACT:ART-CLAUDE-MD"/>
  </FEATURE_BRIDGE>

  <FEATURE_DESIGN ID="FEAT-DESIGN" STATE="IMPLEMENTED" PRIORITY="MEDIUM">
